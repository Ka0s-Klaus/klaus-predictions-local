# =====================================================================
# Pythia — configuración de ejemplo
#
#   cp .env.example .env
#
# Los valores de aquí son los que arrancan sin instalar nada más allá del
# paquete: SQLite y CPU. Ajusta según tu máquina.
# =====================================================================

# --- Identidad -------------------------------------------------------
ORACLE_NAME="Pythia Local Oracle"

# --- LLM (Ollama) ----------------------------------------------------
LLM_MODEL=mistral:7b-instruct-q4_K_M
LLM_BASE_URL=http://192.168.1.126:11434/api
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.95
# Techo de tokens por respuesta. El enjambre lo sube solo cuando necesita
# encajar los siete dictámenes en un único JSON.
LLM_MAX_TOKENS=384
LLM_CONTEXT_LENGTH=4096
# Súbelo si ves LLMUnavailableError: en un i5 de 6ª generación una
# generación larga puede pasar de 20 s con holgura.
LLM_INFERENCE_TIMEOUT=120

# --- Embeddings ------------------------------------------------------
# Requiere el extra opcional: pip install -e ".[embeddings]"
USE_GPU=false
# auto | cpu | cuda | xpu. Con `auto` se prueba lo que haya y se cae a CPU.
EMBEDDING_DEVICE=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2
GPU_MEMORY_FRACTION=0.8

# --- Feeds -----------------------------------------------------------
FEEDS_ENABLED=true
FEEDS_UPDATE_INTERVAL=900
FEEDS_TIMEOUT=20
FEEDS_CONCURRENCY=4
FEEDS_CACHE_DAYS=30
MAX_FEED_SIZE_MB=20

# --- Enjambre MiroFish -----------------------------------------------
MIROFISH_AGENTS=7
CONSENSUS_THRESHOLD=0.65
BRIER_WEIGHTED_VOTING=true
VERBOSE_REASONING=true

# --- Predicción ------------------------------------------------------
PREDICTION_HORIZONS=24h,week,month,year
PREDICTIONS_PER_HORIZON=3
FORECAST_CONFIDENCE_MIN=0.55

# --- API -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8088
# 1 worker en una máquina de 16 GB: cada worker duplica el residente.
API_WORKERS=1
API_TIMEOUT=15
CORS_ORIGINS=http://192.168.1.108:3000,http://192.168.1.108:8088

# --- Base de datos ---------------------------------------------------
# SQLite para desarrollo. En producción:
#   DATABASE_URL=postgresql://pythia_user:TU_PASSWORD@localhost:5432/pythia_oracle
# Requiere el extra: pip install -e ".[postgres]"
DATABASE_URL=sqlite:///./pythia.db
AUDIT_ENABLED=true
AUDIT_SAMPLE_RATE=0.7

# --- Seguridad -------------------------------------------------------
# Genérala con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CAMBIAME-genera-una-clave-aleatoria

# --- Depuración ------------------------------------------------------
DEBUG=false
